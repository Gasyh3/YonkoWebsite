# Copier en .env.local (jamais commité) et renseigner les valeurs.

# Domaine de production, sans barre finale : URL canoniques, sitemap, robots, données structurées.
NEXT_PUBLIC_SITE_URL=https://yonkotech.com

# Formulaire de contact (app/api/contact/route.ts). Au moins un canal en production, sinon le formulaire
# répond « envoi indisponible » et propose l'adresse e-mail.

# 1) E-mail via Resend (https://resend.com) : clé API et domaine d'envoi vérifié chez Resend.
RESEND_API_KEY=
# Expéditeur (domaine vérifié). Par défaut : "Yonko Tech Consulting <site@domaine-du-site>".
CONTACT_FROM=
# Destinataire(s), séparés par des virgules. Par défaut : contact@yonkotech.com.
CONTACT_TO=

# 2) Webhook (Make, Zapier, n8n, CRM…) : reçoit la demande en JSON
#    { name, company, email, subject, message, source, receivedAt }.
CONTACT_WEBHOOK_URL=
