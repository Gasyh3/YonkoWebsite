# Copier en .env (Docker, make docker-up) ou .env.local (npm run dev) : jamais commité.
# Dokploy : NEXT_PUBLIC_* dans « Build-time Arguments », le reste dans « Environment » (docs/deploiement-dokploy.md).
# Les NEXT_PUBLIC_* sont lus AU BUILD : les changer impose de reconstruire l'image.

# Port local du conteneur (docker-compose.yml, Makefile). Inutile sous Dokploy.
APP_PORT=3000

# Domaine de production, sans barre finale : URL canoniques, sitemap, robots, données structurées.
NEXT_PUBLIC_SITE_URL=https://yonko.tech

# Formulaire de contact (app/api/contact/route.ts). Au moins un canal en production, sinon le formulaire
# répond « envoi indisponible » et propose l'adresse e-mail.

# 1) E-mail via Resend (https://resend.com) : clé API et domaine d'envoi vérifié chez Resend.
RESEND_API_KEY=
# Expéditeur (domaine vérifié). Par défaut : "Yonko Tech Consulting <site@domaine-du-site>".
CONTACT_FROM=
# Destinataire(s), séparés par des virgules. Obligatoire avec Resend tant que SITE.email (lib/site.ts) est vide.
CONTACT_TO=

# 2) Webhook (Make, Zapier, n8n, CRM…) : reçoit la demande en JSON
#    { name, company, email, subject, message, source, receivedAt }.
CONTACT_WEBHOOK_URL=

# Anti-robot Cloudflare Turnstile (gratuit) : https://dash.cloudflare.com → Turnstile → ajouter le domaine.
# Définir les DEUX clés (ou aucune : le formulaire fonctionne alors sans captcha). La clé publique est lue au
# build : la redéfinir dans l'hébergeur avant le build. Clés de test officielles : site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA (toujours valide) ou 2x0000000000000000000000000000000AA (toujours refusé).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Questionnaire de cadrage et administration (/questionnaire, /admin)

# Base PostgreSQL. Développement (make services-up) : la valeur ci-dessous. Dokploy : URL interne de la base
# PostgreSQL créée dans Dokploy. Sans DATABASE_URL, le questionnaire est désactivé (le reste du site fonctionne).
DATABASE_URL=postgres://yonko:yonko@localhost:5432/yonko

# Pile docker-compose.yml (make docker-up) : identifiants de la base « db » (le DATABASE_URL du conteneur en
# découle automatiquement).
POSTGRES_USER=yonko
POSTGRES_PASSWORD=yonko
POSTGRES_DB=yonko

# Envoi d'e-mails (lien d'accès, accusé de réception, notifications, connexion admin) par SMTP.
# Développement : Mailpit (make services-up), boîte de réception sur http://localhost:8025.
# Production : Resend (smtps://resend:<clé API>@smtp.resend.com:465) ou Brevo, domaine yonko.tech vérifié.
SMTP_URL=smtp://localhost:1025
# Expéditeur (adresse du domaine vérifié chez le fournisseur ; aucune boîte de réception nécessaire).
MAIL_FROM=Yonko Tech Consulting <bonjour@yonko.tech>
# Adresse de réponse (facultatif) : où arrivent les réponses des clients aux e-mails automatiques.
MAIL_REPLY_TO=

# Adresse de l'administrateur : reçoit les notifications de nouveaux questionnaires, et seule autorisée à se
# connecter sur /admin (lien de connexion envoyé par e-mail).
ADMIN_EMAIL=

# URL publique utilisée dans les liens des e-mails (facultatif : par défaut NEXT_PUBLIC_SITE_URL).
# Développement : http://localhost:3000.
APP_URL=http://localhost:3000
